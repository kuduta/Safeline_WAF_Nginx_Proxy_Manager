# Linux/amd64. Relative paths resolve beside docker-compose.yml.
SAFELINE_DIR=./safeline
SUBNET_PREFIX=172.22.222
IMAGE_PREFIX=chaitin
REGION=-g
ARCH_SUFFIX=
IMAGE_TAG=9.3.10
POSTGRES_IMAGE=chaitin/safeline-postgres:15.2
MGT_PROXY=
ADMIN_BIND_IP=127.0.0.1
MGT_PORT=9443
NPM_ADMIN_PORT=81
# Independent random hex passwords (32 bytes or more); safe in PostgreSQL URIs.
POSTGRES_PASSWORD=
NPM_DB_PASSWORD=
NPM_DB_ROOT_PASSWORD=
MGT_INTERNAL_TOKEN=
DETECTOR_MGMT_TOKEN=

# Optional: replace the placeholder ip syslog with the receiver IP/hostname before enabling syslog.
SYSLOG_ADDRESS=tcp://ip syslog:514

